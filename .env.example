# ── MoMo (momoAPIs.md §3) — three subscriptions, one identity ──────────────
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Sandbox only. An API user belongs to the subscription key it was created
# under (momoAPIs.md §8b), and momo-provision.mjs creates ours with the
# COLLECTION key -- so disbursements need their own pair or every call returns
# NOT_ALLOWED_TARGET_ENVIRONMENT. Absent, they fall back to MOMO_API_USER/KEY,
# which is what production wants: MTN issues one user for everything there.
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=

# M5d. Telegram chat ids allowed to run /pay, /status and /send.
# EMPTY MEANS NOBODY, never everybody -- the bot is public and these commands
# ring a real phone. Comma or space separated; group ids are negative.
# vercel-env.mjs refuses a live push while this is empty.
TELEGRAM_PAY_CHAT_IDS=

# The payout ceiling against a live environment, in minor units. Default 10
# (R0.10) -- a tenth of MOMO_LIVE_MAX_MINOR, because a transfer has no second
# human to decline it.
MOMO_PAYOUT_MAX_MINOR=
MOMO_REMITTANCE_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox

# The live spend guard (src/lib/momo/budget.ts).
#
# Anything other than the exact string "sandbox" above is treated as REAL
# MONEY, and the whole live testing budget is about R10. Outbound amounts are
# then capped per transaction; the default is 100 minor units (R1.00), so ten
# transactions spend the budget and no more. Sandbox is uncapped, because
# sandbox money is not real.
#
# Raise this ONLY deliberately. It is not a tuning knob, it is a brake.
MOMO_LIVE_MAX_MINOR=100
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CALLBACK_HOST=
MOMO_MODE=emulator

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Agent (ADR-0012) — Gemini primary, Groq fallback ───────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Voice (ADR-0011) — English only in v1 ──────────────────────────────────
ELEVENLABS_API_KEY=

# ── Channels ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Scheduler (ADR-0006) ───────────────────────────────────────────────────
CRON_SECRET=

# The ONE number `/pay` may request money from, on either channel.
# NEVER read from a chat message: a bot that pays any number typed at it is a
# machine for pushing unsolicited payment prompts over MTN. See
# src/server/momo/demo-collect.ts. Sandbox fixture 46733123454 auto-resolves.
MOMO_DEMO_MSISDN=46733123454
