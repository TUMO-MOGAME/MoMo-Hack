# ── MoMo (momoAPIs.md §3) — three subscriptions, one identity ──────────────
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_REMITTANCE_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox

# The live spend guard (src/lib/momo/budget.ts).
#
# Anything other than the exact string "sandbox" above is treated as REAL
# MONEY, and the whole live testing budget is about R10. Outbound amounts are
# then capped per transaction; the default is 100 minor units (R1.00), so ten
# transactions spend the budget and no more. Sandbox is uncapped, because
# sandbox money is not real.
#
# Raise this ONLY deliberately. It is not a tuning knob, it is a brake.
MOMO_LIVE_MAX_MINOR=100
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CALLBACK_HOST=
MOMO_MODE=emulator

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Agent (ADR-0012) — Gemini primary, Groq fallback ───────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Voice (ADR-0011) — English only in v1 ──────────────────────────────────
ELEVENLABS_API_KEY=

# ── Channels ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Scheduler (ADR-0006) ───────────────────────────────────────────────────
CRON_SECRET=
