    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
